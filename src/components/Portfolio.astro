---
interface Props { lang: 'pt' | 'en' }
const { lang } = Astro.props;
const en = lang === 'en';
const copy = en ? {
  navAbout:'About',navExpertise:'Expertise',navProcess:'Approach',navContact:'Contact',availability:'Open to opportunities',
  eyebrow:'FULLSTACK DEVELOPMENT · DEVOPS · AUTOMATION',lead:'Turning complexity into',accent:'simple solutions.',intro:'I design, develop and deliver reliable digital products — from thoughtful interfaces to the infrastructure that keeps everything running.',work:'Explore expertise',talk:"Let's talk",scroll:'Scroll to explore',aboutLabel:'01 / ABOUT',aboutTitle:'Technology with purpose.',aboutText:'I am Pedro Arcoverde, a fullstack developer and DevOps analyst. I enjoy connecting product thinking, engineering and automation to build scalable, maintainable solutions from idea to production.',aboutQuote:'Great technology is not just about writing code. It is about solving the right problem, in the right way.',skillLabel:'02 / EXPERTISE',skillTitle:'From concept to deployment.',skillIntro:'A multidisciplinary toolkit to turn ideas into real applications.',processLabel:'03 / HOW I WORK',processTitle:'Beyond the code.',processIntro:'I value simple architecture, clear communication and continuous improvement.',steps:[['01','Understand','Start with context, challenges and the outcome that really matters.'],['02','Design','Choose pragmatic solutions focused on clarity, reliability and growth.'],['03','Build & evolve','Deliver iteratively, automate wherever useful and improve with feedback.']],contactLabel:'04 / CONNECT',contactTitle:"Let's build something meaningful.",contactText:'Have a challenge, an idea or an opportunity? I would love to hear about it.',email:'Send an email',back:'Back to top',footer:'Built with intention, Astro and CSS.',stack:['Python · JavaScript · Go','Web applications · APIs · HTML & CSS','Linux · Shell · CI/CD · GitHub Actions','Docker · Podman · Kubernetes','Infrastructure · Automation · Observability'],tags:['FULLSTACK','DEVOPS','AUTOMATION'],download:'GitHub profile'
} : {
  navAbout:'Sobre',navExpertise:'Especialidades',navProcess:'Método',navContact:'Contato',availability:'Aberto a oportunidades',
  eyebrow:'DESENVOLVIMENTO FULLSTACK · DEVOPS · AUTOMAÇÃO',lead:'Transformando complexidade em',accent:'soluções simples.',intro:'Idealizo, desenvolvo e entrego produtos digitais confiáveis — de interfaces bem pensadas à infraestrutura que mantém tudo funcionando.',work:'Explorar especialidades',talk:'Vamos conversar',scroll:'Role para explorar',aboutLabel:'01 / SOBRE',aboutTitle:'Tecnologia com propósito.',aboutText:'Sou Pedro Arcoverde, desenvolvedor fullstack e analista DevOps. Gosto de unir visão de produto, engenharia e automação para criar soluções escaláveis e fáceis de manter, da ideia à produção.',aboutQuote:'Boa tecnologia não é apenas escrever código. É resolver o problema certo, da maneira certa.',skillLabel:'02 / ESPECIALIDADES',skillTitle:'Da ideia ao deploy.',skillIntro:'Uma atuação multidisciplinar para transformar ideias em aplicações reais.',processLabel:'03 / COMO TRABALHO',processTitle:'Muito além do código.',processIntro:'Valorizo arquitetura simples, comunicação clara e melhoria contínua.',steps:[['01','Entender','Começar pelo contexto, pelos desafios e pelo resultado que realmente importa.'],['02','Projetar','Escolher soluções pragmáticas com foco em clareza, confiabilidade e evolução.'],['03','Construir e evoluir','Entregar de forma incremental, automatizar o que faz sentido e melhorar com feedback.']],contactLabel:'04 / CONTATO',contactTitle:'Vamos construir algo relevante.',contactText:'Tem um desafio, uma ideia ou uma oportunidade? Vou gostar de conversar.',email:'Enviar e-mail',back:'Voltar ao topo',footer:'Feito com intenção, Astro e CSS.',stack:['Python · JavaScript · Go','Aplicações web · APIs · HTML & CSS','Linux · Shell · CI/CD · GitHub Actions','Docker · Podman · Kubernetes','Infraestrutura · Automação · Observabilidade'],tags:['FULLSTACK','DEVOPS','AUTOMAÇÃO'],download:'Perfil no GitHub'
};
const cards=en?[
  {num:'01',name:'Fullstack engineering',description:'Intuitive interfaces, robust backends and integrations that make everyday work easier.',items:['Python','JavaScript','Go','APIs','Web']},
  {num:'02',name:'DevOps & infrastructure',description:'Reliable deployments and infrastructure designed for visibility and maintainability.',items:['Linux','CI/CD','Docker','Kubernetes','GitHub Actions']},
  {num:'03',name:'Automation & systems',description:'Connecting tools, data and processes to reduce manual work and create real impact.',items:['Shell','Pipelines','Monitoring','Integrations','Performance']}
]:[
  {num:'01',name:'Engenharia fullstack',description:'Interfaces intuitivas, backends sólidos e integrações que simplificam o dia a dia.',items:['Python','JavaScript','Go','APIs','Web']},
  {num:'02',name:'DevOps e infraestrutura',description:'Deploys confiáveis e infraestrutura pensada para visibilidade e manutenção.',items:['Linux','CI/CD','Docker','Kubernetes','GitHub Actions']},
  {num:'03',name:'Automação e sistemas',description:'Conecto ferramentas, dados e processos para reduzir tarefas manuais e gerar impacto.',items:['Shell','Pipelines','Monitoramento','Integrações','Performance']}
];
const canonical = en ? 'https://greenarch.com.br/en/' : 'https://greenarch.com.br/';
const description=en?'Pedro Arcoverde — Fullstack Developer & DevOps Analyst. Engineering, automation and modern digital experiences.':'Pedro Arcoverde — Desenvolvedor Fullstack e Analista DevOps. Engenharia, automação e experiências digitais modernas.';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#071b17" />
  <meta name="description" content={description} />
  <meta name="author" content="Pedro Arcoverde" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Pedro Arcoverde | Fullstack & DevOps" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://greenarch.com.br/profile.jpg" />
  <meta name="twitter:card" content="summary" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="pt-BR" href="https://greenarch.com.br/" />
  <link rel="alternate" hreflang="en" href="https://greenarch.com.br/en/" />
  <link rel="alternate" hreflang="x-default" href="https://greenarch.com.br/" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <title>Pedro Arcoverde — Fullstack & DevOps | GreenArch</title>
</head>
<body>
  <a class="skip-link" href="#main">{en?'Skip to content':'Pular para o conteúdo'}</a>
  <div class="ambient" aria-hidden="true"><span class="orb orb-one"></span><span class="orb orb-two"></span><span class="orb orb-three"></span><div class="grid-lines"></div></div>
  <div class="site-shell" id="top">
    <div class="topbar"><a href="#top" class="brand" aria-label="GreenArch — home"><span class="brand-mark">G<span>.</span></span><span>greenarch<span class="brand-dot">.</span></span></a>
      <nav class="nav" aria-label={en?'Main navigation':'Navegação principal'}>
        <a href="#sobre">{copy.navAbout}</a><a href="#especialidades">{copy.navExpertise}</a><a href="#metodo">{copy.navProcess}</a><a class="nav-contact" href="#contato">{copy.navContact}<span aria-hidden="true">↗</span></a>
      </nav>
      <div class="languages" aria-label={en?'Language':'Idioma'}><a href="/" lang="pt-BR" aria-current={!en?'page':undefined}>PT</a><span aria-hidden="true">/</span><a href="/en/" lang="en" aria-current={en?'page':undefined}>EN</a></div>
    </div>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <span class="availability"><span class="live-dot"></span>{copy.availability}</span>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1 id="hero-title">{copy.lead}<br/><span class="gradient-text">{copy.accent}</span></h1>
          <p class="hero-intro">{copy.intro}</p>
          <div class="hero-actions"><a class="button primary" href="#especialidades">{copy.work}<span aria-hidden="true">↗</span></a><a class="button secondary" href="#contato">{copy.talk}<span aria-hidden="true">→</span></a></div>
          <div class="hero-bottom"><span class="decor-line"></span><span>{copy.scroll}</span><span aria-hidden="true">↓</span></div>
        </div>
        <div class="hero-art">
          <div class="portrait-frame"><div class="portrait-glow"></div><img src="/profile.jpg" alt={en?'Portrait of Pedro Arcoverde':'Retrato de Pedro Arcoverde'} width="420" height="420" fetchpriority="high"/><div class="portrait-caption"><span class="caption-symbol">✳</span><div><strong>Pedro Arcoverde</strong><small>Fullstack / DevOps</small></div></div></div>
          <div class="floating-label label-one">01 <span>DESIGN + ENGINEERING</span></div><div class="floating-label label-two">&lt;/&gt; <span>BUILD · SHIP · EVOLVE</span></div>
        </div>
      </section>
      <section id="sobre" class="section about-section" aria-labelledby="about-title">
        <div class="section-kicker">{copy.aboutLabel}</div><div class="about-grid"><div><h2 id="about-title">{copy.aboutTitle}</h2><p class="section-lead">{copy.aboutText}</p><a class="inline-link" href="https://github.com/ArcoverdePedro" target="_blank" rel="noopener noreferrer">{copy.download} <span aria-hidden="true">↗</span></a></div><blockquote><span class="quote-mark">“</span>{copy.aboutQuote}</blockquote></div>
      </section>
      <section id="especialidades" class="section expertise" aria-labelledby="skills-title">
        <div class="section-kicker">{copy.skillLabel}</div><div class="section-heading"><h2 id="skills-title">{copy.skillTitle}</h2><p>{copy.skillIntro}</p></div>
        <div class="expertise-grid">{cards.map((card)=><article class="expertise-card"><div class="card-top"><span>{card.num} / 03</span><span aria-hidden="true">↗</span></div><div class="card-icon" aria-hidden="true">{card.num==='01'?'⌘':card.num==='02'?'◈':'✳'}</div><h3>{card.name}</h3><p>{card.description}</p><div class="chips">{card.items.map((item)=><span>{item}</span>)}</div></article>)}</div>
      </section>
      <section id="metodo" class="section method" aria-labelledby="method-title">
        <div class="section-kicker">{copy.processLabel}</div><div class="method-heading"><h2 id="method-title">{copy.processTitle}</h2><p>{copy.processIntro}</p></div><div class="step-list">{copy.steps.map(([n,heading,detail])=><div class="step"><span class="step-number">{n}</span><h3>{heading}</h3><p>{detail}</p><span class="step-arrow" aria-hidden="true">↗</span></div>)}</div>
      </section>
      <section id="contato" class="section contact-section" aria-labelledby="contact-title"><div class="contact-panel"><div class="section-kicker">{copy.contactLabel}</div><h2 id="contact-title">{copy.contactTitle}</h2><p>{copy.contactText}</p><div class="contact-actions"><a class="button contact-email" href="mailto:pedroarcoverde2@gmail.com?subject=Contato%20via%20GreenArch">{copy.email}<span aria-hidden="true">↗</span></a><a class="social-link" href="https://github.com/ArcoverdePedro" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a class="social-link" href="https://www.linkedin.com/in/pedro-arcoverde-938b83236" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div></section>
    </main>
    <footer><span>© {new Date().getFullYear()} Pedro Arcoverde</span><span>{copy.footer}</span><a href="#top">{copy.back} ↑</a></footer>
  </div>
</body>
</html>
<style is:global>
:root{color-scheme:dark;--bg:#071b17;--panel:#0b251f;--panel-alt:#0f2e27;--text:#ecf7f0;--muted:#a6bdb1;--line:rgba(165,219,188,.15);--accent:#62d8a0;--accent-bright:#a3f2bd;--font:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
*,*::before,*::after{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:95px}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button,a{-webkit-tap-highlight-color:transparent}a:focus-visible{outline:2px solid var(--accent-bright);outline-offset:5px}::selection{background:#4abf84;color:#061811}.skip-link{position:absolute;left:16px;top:-80px;z-index:30;padding:12px;background:var(--accent-bright);color:#051911}.skip-link:focus{top:12px}.ambient{position:absolute;inset:0 0 auto 0;height:1100px;overflow:hidden;pointer-events:none;z-index:0}.ambient::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 58% 48% at 85% 23%,rgba(30,115,80,.25),transparent 75%),radial-gradient(ellipse 65% 52% at 10% 65%,rgba(23,89,67,.21),transparent 75%)}.orb{position:absolute;display:block;border-radius:50%;filter:blur(55px);opacity:.34;will-change:transform;animation:drift 18s ease-in-out infinite alternate}.orb-one{width:350px;height:350px;top:12%;right:4%;background:#1d9564}.orb-two{width:260px;height:260px;top:36%;left:-120px;background:#22775e;animation-delay:-8s}.orb-three{width:210px;height:210px;top:65%;right:33%;background:#70b68a;opacity:.11;animation-delay:-13s}.grid-lines{position:absolute;inset:0;opacity:.19;background-image:linear-gradient(to right,rgba(176,231,197,.13) 1px,transparent 1px),linear-gradient(to bottom,rgba(176,231,197,.13) 1px,transparent 1px);background-size:72px 72px;mask-image:linear-gradient(to bottom,#000 0%,transparent 94%);animation:grid-move 35s linear infinite}@keyframes drift{to{transform:translate3d(-80px,65px,0) scale(1.2)}}@keyframes grid-move{to{background-position:72px 72px}}.site-shell{max-width:1240px;margin:auto;padding:0 36px;position:relative;z-index:1}.topbar{height:96px;display:flex;align-items:center;gap:35px;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;font-size:1.28rem;font-weight:750;letter-spacing:-.055em;white-space:nowrap}.brand-mark{font-size:1rem;display:grid;place-items:center;width:34px;height:34px;border:1px solid rgba(98,216,160,.6);border-radius:10px;color:#b7f9d1;background:rgba(64,161,110,.1)}.brand-mark span{color:var(--accent)}.brand-dot{color:var(--accent)}.nav{margin-left:auto;display:flex;align-items:center;gap:28px;color:var(--muted);font-size:.85rem}.nav a,.languages a,.inline-link,.social-link,footer a{transition:color .2s}.nav a:hover,.languages a:hover,.inline-link:hover,.social-link:hover,footer a:hover{color:var(--accent-bright)}.nav-contact{color:var(--text)!important}.nav-contact span{padding-left:7px;color:var(--accent)}.languages{display:flex;gap:8px;font-size:.8rem;font-weight:650;color:#6f9a85;border-left:1px solid var(--line);padding-left:24px}.languages a[aria-current="page"]{color:var(--accent-bright)}.hero{min-height:690px;display:grid;grid-template-columns:1.25fr .75fr;gap:40px;align-items:center;padding:92px 0 100px}.availability{display:inline-flex;align-items:center;gap:9px;border:1px solid rgba(111,210,151,.28);background:rgba(35,100,68,.2);border-radius:100px;color:#b7ebca;padding:9px 14px;font-size:.75rem;font-weight:600}.live-dot{width:7px;height:7px;border-radius:50%;background:#76f1a8;box-shadow:0 0 0 4px rgba(98,216,160,.1);animation:pulse 2s infinite}@keyframes pulse{50%{box-shadow:0 0 0 8px rgba(98,216,160,0)}}.eyebrow{color:var(--accent);font-size:.72rem;letter-spacing:.2em;font-weight:730;margin:37px 0 22px}.hero h1{font-weight:760;font-size:clamp(2.9rem,5vw,5.3rem);line-height:1.09;letter-spacing:-.065em;margin:0;max-width:820px}.gradient-text{background:linear-gradient(110deg,#bcf6ce 0%,#5cce93 68%,#82e8b6);color:transparent;background-clip:text}.hero-intro{font-size:1.08rem;line-height:1.8;color:var(--muted);max-width:600px;margin:27px 0 35px}.hero-actions,.contact-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center}.button{display:inline-flex;align-items:center;justify-content:center;gap:26px;font-weight:700;font-size:.89rem;min-height:50px;padding:13px 22px;border-radius:9px;transition:transform .2s,background .2s,box-shadow .2s}.button:hover{transform:translateY(-3px)}.primary{background:#86e7b1;color:#082218}.primary:hover{background:#b2f4cf;box-shadow:0 10px 25px rgba(93,214,148,.18)}.secondary{border:1px solid rgba(170,232,194,.24);background:rgba(9,39,30,.64)}.secondary:hover{background:#133e2e}.hero-bottom{margin-top:83px;display:flex;gap:14px;align-items:center;font-size:.76rem;letter-spacing:.09em;color:var(--muted)}.decor-line{height:1px;background:var(--accent);width:32px}.hero-art{position:relative;display:flex;justify-content:center;align-items:center;min-height:440px}.portrait-frame{width:min(100%,365px);aspect-ratio:1/1.13;position:relative;border:1px solid rgba(154,228,186,.27);border-radius:26px;transform:rotate(2deg);background:linear-gradient(145deg,rgba(47,142,91,.24),rgba(7,27,23,.9));padding:12px;box-shadow:0 32px 90px rgba(0,0,0,.27)}.portrait-frame:before{content:"";position:absolute;inset:-16px;border:1px solid rgba(98,216,160,.12);border-radius:32px;pointer-events:none}.portrait-frame>img{width:100%;height:100%;object-fit:cover;border-radius:17px;filter:saturate(.85);transform:rotate(-.5deg)}.portrait-glow{position:absolute;width:130%;height:100%;border-radius:50%;background:rgba(78,202,127,.12);filter:blur(60px);z-index:-1}.portrait-caption{position:absolute;bottom:26px;left:26px;right:26px;border-radius:12px;padding:13px;display:flex;gap:12px;align-items:center;background:rgba(4,26,19,.82);backdrop-filter:blur(14px);border:1px solid rgba(184,236,203,.2);transform:rotate(-2deg)}.caption-symbol{font-size:1.8rem;color:var(--accent)}.portrait-caption strong,.portrait-caption small{display:block}.portrait-caption strong{font-size:.84rem}.portrait-caption small{font-size:.7rem;color:var(--muted);margin-top:3px}.floating-label{position:absolute;display:flex;align-items:center;gap:10px;padding